package JavaEasyBook;

public class PracticePg58D {
	/*a program to print pattern
 	* 5 
 	* 5 4 
 	* 5 4 3 
 	* 5 4 3 2 
 	* 5 4 3 2 1    
 	* System.out.print("* ");*/
	public static void main(String[] args) {
		
		int i, j;
		for(i = 5; i >= 1; i--) {
			System.out.print("* ");
			for(j = 1; j <= i; j++) {
				System.out.print(j + " ");
			}
			System.out.println();
		}

	}

}
