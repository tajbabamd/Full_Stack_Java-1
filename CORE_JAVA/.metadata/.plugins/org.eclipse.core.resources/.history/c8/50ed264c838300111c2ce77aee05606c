package JavaEasyBook;

public class PracticePg56E {
	/*a program to print pattern 
	 * [1 2 3 4 5
	 *  1       5 
	 *  1       5
	 *  1 2 3 4 5 ]*/
	public static void main(String[] args) {
		
		int i, j;
		for(i = 1; i <= 4; i++) {
			for(j = 1; j <= 5; j++) {
				System.out.print(j + " ");
				for(int row = 2; row <= 4; row++) {
					System.out.print(" ");
				}
				
			}
			System.out.println();
		}

	}

}
