package JavaEasyBook;

public class PracticePg58G {
	/*a program to print pattern
	 	
		* System.out.print("* ");*/

	public static void main(String[] args) {
		
		int i, j;
		for(i = 1; i <=5; i++) {
			System.out.print("* ");
			for(j = i; j >= i; j++) {
				System.out.println(i + " ");
			}
			System.out.println();
		}

	}

}
