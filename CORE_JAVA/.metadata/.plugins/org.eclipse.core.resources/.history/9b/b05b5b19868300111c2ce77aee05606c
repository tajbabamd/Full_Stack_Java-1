package JavaEasyBook;

public class PracticePg57B {
	/*a program to print pattern 
	 * [A A A A A
	 *  B B B B B 
	 *  C C C C C
	 *  D D D D D 
	 *  E E E E E ]*/
	public static void main(String[] args) {
		
		for(char i = 65; i <= 69; i++) {
			for(int j = 1; j <= 5; j++) {
				System.out.println(i + " ");
			}
			System.out.println();
		}
	}

}
