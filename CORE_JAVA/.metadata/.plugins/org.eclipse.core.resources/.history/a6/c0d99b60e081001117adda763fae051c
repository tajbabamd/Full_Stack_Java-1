package JavaEasyBook;

import java.util.Scanner;

public class PracticePg51F {
	/*read a number and prints number of factors*/
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		int n, i, x =0;
		System.out.println("Enter a number:");
		n = sc.nextInt();
		
		for(i = 1; i <= n; i++) {
			if(n%i == 0) {
				System.out.print(i+" ");
				x += 1;
			}
		}
		System.out.println("\n  number of foctor for "+n+" : " + x);
		sc.close();
	}

}
