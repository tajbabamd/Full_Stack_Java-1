package JavaEasyBook;

import java.util.Scanner;

public class PracticePg60C {
	/*read a number and print odd digits usning while loop*/

	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		String n;
		int ld, i;
		
		System.out.println("Enter a number:");
		n = sc.nextLine();
		i = 0;
		while(i <= n.length()) {
			char ch = n.charAt(i);
			ld = (int) ch;
			i++;			
			if(ld%2 ==1) {
				System.out.print(ld + " ");
			}
		}
		sc.close();
		

	}

}
