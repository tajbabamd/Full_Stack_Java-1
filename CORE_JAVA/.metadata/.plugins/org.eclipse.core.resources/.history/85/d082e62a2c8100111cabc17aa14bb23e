package JavaEasyBook;

import java.util.Scanner;

public class PracticePg43A {

	public static void main(String[] args) {

		Scanner sc = new Scanner(System.in);
		char ch;
		
		System.out.println("Enter character: ");
		ch = sc.next().charAt(0);
		char chara[] = {'a', 'e', 'i', 'o', 'u'};
		
		for(char x : chara) {
			if(ch == x) {
				System.out.println("character "+ch+ "is an Vowel.");
				break;
			}else if (ch != x){
				System.out.println("character "+ch+ "is Consonent.");
			}
		}
		
		
		sc.close();

	}

}
