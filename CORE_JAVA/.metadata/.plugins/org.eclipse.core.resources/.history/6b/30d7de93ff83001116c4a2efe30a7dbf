class Account{
	private String customerName;
	private int accountNum;
	private double balance;
	public String getCustomerName() {
		return customerName;
	}
	public void setCustomerName(String customerName) {
		this.customerName = customerName;
	}
	public int getAccountNum() {
		return accountNum;
	}
	public void setAccountNum(int accountNum) {
		this.accountNum = accountNum;
	}
	public double getBalance() {
		return balance;
	}
	public void setBalance(double balance) {
		this.balance = balance;
	}
	@Override
	public String toString() {
		return "Account \n[customerName=" + customerName +
			   ", accountNum=" + accountNum + ", balance=" + balance + "]";
	}
	
	public void transferMoney(Account object, double amount) {
//		this.balance = object.balance;
		if(amount <= this.balance) {
			this.balance+=amount;
			object.balance-=amount;
			System.out.println("amount transfered");
		}else {
			this.balance =0;
			System.out.println("cannot transfer money due to insufficient balance in Account1");
		}
	}
	
}
public class CopyObjects {

	public static void main(String[] args) {
		
		Account acc1 = new Account();
		Account acc2 = new Account();
		
		acc1.setCustomerName("Ramesh");
		acc1.setAccountNum(123456);
		acc1.setBalance(15000);
		
		acc2.setCustomerName("Rajesh");
		acc2.setAccountNum(654321);
		acc2.setBalance(100);

		
		System.out.println(acc1);
		System.out.println(acc2);
		System.out.println();
		
		acc2.transferMoney(acc1, 100.00);
//		acc1.transferMoney(acc2, 1.00);

		
		System.out.println("account1 : "+acc1);
		System.out.println("account2 : "+acc2);

	}

}
