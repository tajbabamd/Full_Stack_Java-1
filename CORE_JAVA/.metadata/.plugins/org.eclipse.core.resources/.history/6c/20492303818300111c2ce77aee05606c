package JavaEasyBook;

public class PracticePg56E {
	/*a program to print pattern 
	 * [1 2 3 4 5
	 *  1       5 
	 *  1       5
	 *  1 2 3 4 5 ]*/
	public static void main(String[] args) {
		
		int i, j, k, m;
		for(i = 1; i <= 4; i++) {
			for(j = 1; j <= 5; j++) {
					if(j == 2 || j == 2 && i == 2 || i == 3 || i == 4) {
						System.out.print("* ");
						break;
					}
			}
			System.out.println();
		}

	}

}
