package JavaEasyBook;

import java.util.Scanner;

public class PracticePg45A {

	public static void main(String[] args) {

		Scanner sc = new Scanner(System.in);
		
		int a, b, c;
		
		System.out.println("Enter three numbers: ");
		a = sc.nextInt();
		b = sc.nextInt();
		c = sc.nextInt();
		
		if(a < b && a < c || b < c && b < a || c < a && c < b) {			
			if( a < b && a < c) {
				System.out.print(" "+ a +" ");
			}else if(b < c && b < a) {
				System.out.print(" "+ b +" ");
			}else if(c < a && c < b) {
				System.out.print(" "+ c +" ");
			}
		}else if(b < c || c < a) {
			if(b < c) {
				System.out.print(" "+ b +" ");
				if(c < a) {
					System.out.print(" "+ c +" ");
				}
			}
		}
	
	
	}

}
