package JavaEasyBook;

public class PracticePg58E {
	/*a program to print pattern
	 
	 * System.out.print("* ");*/

	public static void main(String[] args) {
		
		int i, j;
		for(i = 5; i >= 1; i--) {
			System.out.print("* ");
			for(j = 5; j >= i; j--) {
				System.out.print(j + " ");
			}
			System.out.println();
		}
	}

}
