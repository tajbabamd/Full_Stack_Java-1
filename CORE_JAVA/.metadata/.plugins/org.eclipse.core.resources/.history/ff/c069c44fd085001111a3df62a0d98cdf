package JavaEasyBook;

public class PracticePg58E {
	/*a program to print pattern
 	   
 	* System.out.print("* ");*/

	public static void main(String[] args) {
		
		int i, j;
		for(i = 1; i <= 5; i++) {
			for(j = 1; j <= 5; j++) {
				System.out.print(j%2 + " ");
			}
			System.out.print();
		}

	}

}
