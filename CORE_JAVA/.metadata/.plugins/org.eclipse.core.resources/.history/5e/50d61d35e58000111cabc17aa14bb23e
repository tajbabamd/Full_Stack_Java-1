class Triangle1{
	
	// state
	private double base, height, area;
	
	//behavior
	//setter methods
	public void setBase(double base1) {
		base = base1;
	}
	public void setHeight(double height1) {
		height = height1;
	}
	
	//getter methods 
	public double getBase() {
		return base;
	}
	public double getHeight() {
		return height;
	}
	public double getArea() {
		return area;
	}
	
	
	//print methods
	public void printBase() {
		System.out.println("base= " +base);
	}
	public void printHeight() {
		System.out.println("height= " + height);
	}
	
	//calculation methods 
	public void calculateArea() {
		area = 0.5 * base * height;
	}
}
public class Class2 {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		
		Triangle1 tob = new Triangle1();
		
		tob.setBase(2.2);
		tob.setHeight(3.6);
		tob.printBase();
		tob.printHeight();
		
		double a, b;
		a = tob.getBase();
		b = tob.getHeight();
		
		
		System.out.println( "base : " + a);
		System.out.println( "height : " + b);
		
		tob.calculateArea();
		System.out.println("area : " + tob.getArea());
		

	}

}
