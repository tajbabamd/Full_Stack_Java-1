package JavaEasyBook;

public class PracticePg56E {
	/*a program to print pattern 
	 * [1 2 3 4 5
	 *  1       5 
	 *  1       5
	 *  1 2 3 4 5 ]*/
	public static void main(String[] args) {
		
		int i, j, k, m;
		for(i = 1; i <= 5; i++) {
			System.out.print("i: " + i+ "| ");
			for(j = 5; j >= 1; j++) {
				System.out.print("j: " + j + "| ");
				for(k = 1; k <=2; k++) {
					System.out.print("k: " + k + "| ");
				}
			}
			System.out.println();
		}

	}

}
