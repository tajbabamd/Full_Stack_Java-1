package JavaEasyBook;

import java.util.Scanner;

public class PracticePg60C {
	/*read a number and print odd digits usning while loop*/

	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		int n, ld;
		
		System.out.println("Enter a number:");
		n = sc.nextInt();
		
		while(n > 0) {
			ld = n % 10;
			if(ld%2 == 1) {				
				System.out.print(ld + " ");
			}
			n = n/10;
		}
		sc.close();
		

	}

}
