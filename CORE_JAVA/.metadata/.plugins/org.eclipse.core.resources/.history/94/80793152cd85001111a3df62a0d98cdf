package JavaEasyBook;

public class PracticePg58B {
	/*a program to print pattern
 	* 1 2 3 4 5 
	* 1 2 3 4 
	* 1 2 3 
	* 1 2 
	* 1  */

	public static void main(String[] args) {
		
		int i, j;
		for(i = 1; i <= 5; i--) {
			for(j = 5; j >= i; j--) {
				System.out.print(j);
			}
			System.out.println();
		}

	}

}
