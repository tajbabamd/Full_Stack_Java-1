package JavaEasyBook;

import java.util.Scanner;

public class PracticePg40A {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		Scanner sc = new Scanner(System.in);
		
		int choice, a = 0, b = 0, c;
		double div;
		
		System.out.println("CALCULATOR MENU");
		System.out.println("-".repeat(40));
		System.out.println("1.ADD");
		System.out.println("2.SUB");
		System.out.println("3.MUL");
		System.out.println("4.DIVI");
		System.out.println("-".repeat(40));
		System.out.println();
		
		System.out.println("Enter choice: ");
		choice = sc.nextInt();
		
		System.out.println("Enter two numbers: ");
		a = sc.nextInt();
		b = sc.nextInt();
	
		if(choice == 1) {
			c = a + b;
			System.out.println("Addition \n a + b : " +c);
		}else if(choice == 2) {
			c = a - b;
			System.out.println("Substraction \n a - b : " +c);
		}else if(choice == 3) {
			c = a * b;
			System.out.println("Multiplication \n a * b : " +c);
		}else if(choice == 4) {
			div = a /(double) b;
			System.out.println("Divition \n a / b : " +div);
		}
		sc.close();

	}

}
