package JavaEasyBook;

import java.util.Scanner;

public class PracticePg54F {
	/*print perfect numbers between n and m
	 * a positive integer which equals to its sum of its factors is a perfect number*/
	
	public void line() {
		System.out.println();
	}
	public void enteredIf()
	
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		
		int n, m, i, j, sum = 0;
		
		System.out.println("Enter a number m: ");
		n = sc.nextInt();
		System.out.println("Enter a number m: ");
		m = sc.nextInt();
		
		for(i = 1; i <= m; i++) {
		
			for(j = n; j <= m; j++) {
				
				if(j%i == 0) {
					sum += i;
				
					System.out.println("entered if condition");
			
				}
			}
			
			System.out.println("end of loop j");
			
			if(sum == j) {
				System.out.println(j + " is a perfect number");
			}else {
				System.out.println(j + " is not a perfect number");
			}

		}
		System.out.println("end of loop i");
		sc.close();
	}

}

