package JavaEasyBook;

import java.util.Scanner;

public class PracticePg48A {
	/* a program to print name 10 times */ 

	public static void main(String[] args) {
		
		Scanner sc = new Scanner(System.in);
		
		String name;
		System.out.println("Enter a Name to print 10 times:");
		name = sc.nextLine();
		
		for(int i = 0; i <= 10; i++) {
			System.out.print(i + "." + name + ", ");
		}

		sc.close();
	}

}
