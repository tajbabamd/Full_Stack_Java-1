package JavaEasyBook;

public class PracticePg56C {
	/*a program to print pattern 
	 * [* * * * * 
	 * * * * * *
	 * * * * * *
	 * * * * * *
	 * * * * * *]*/
	public static void main(String[] args) {
		
		int i, j;
		for(i = 1; i <= 5; i++) {
			for(j = 1; j <= 5; j++) {
				System.out.print("* ");
			}
			System.out.println();
		}

	}

}
