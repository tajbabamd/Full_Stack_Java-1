package JavaEasyBook;

import java.util.Scanner;

public class PracticePg54D {
	/*rean n umbers and print each numbers factors*/
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		int n, m, i, j;
		System.out.println("Enter a number: ");
		n = sc.nextInt();
		for(i = 1; i <= n; i++) {
			System.out.println("\nEnter a number:");
			m = sc.nextInt();
			for(j = 1; j <= m; j++) {
				if(m%j == 0) {
					System.out.print(j + " ");
				}
			}
		}
		System.out.println("\ncode ended.");
		sc.close();
	}

}
