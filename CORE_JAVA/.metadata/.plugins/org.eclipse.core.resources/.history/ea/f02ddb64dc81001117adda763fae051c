package JavaEasyBook;

import java.util.Scanner;

public class PracticePg51C {
	/*read n and print and multiply its fact*/
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		int n, i, factorial=1;
		System.out.println("Enter number n:");
		n = sc.nextInt();
		
		for(i = 1; i <= n; i++) {
			if(n%i == 0) {
				System.out.print(i + " ");
				factorial*=i;
			}
		}
		System.out.println("\nfactorial: "+ factorial);

	}

}
