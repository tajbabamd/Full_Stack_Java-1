package JavaEasyBook;

public class PracticePg55A {
	/*a program to print pattern
	 * 11111
	 * 22222
	 * 33333
	 * 44444*/
	public static void main(String[] args) {
		
		int i, j;
		for(i = 1; i <= 5; i++) {
			for(j = i; j <=4) {
				System.out.print(j + " ");
			}
			System.out.println();
		}

	}

}
