package JavaEasyBook;

public class PracticePg56E {
	/*a program to print pattern 
	 * [1 2 3 4 5
	 *  1       5 
	 *  1       5
	 *  1 2 3 4 5 ]*/
	public static void main(String[] args) {
		
		int i, j, k, m;
		for(i = 1; i <= 4; i++) {
			for(j = 1; j <= 5; j++) {
				if(i == 1 && i == 4) {
					System.out.print(j + " ");					
				}else {
					if(j == 1) {
						System.out.println("1");
					}else if(j == 5) {
						System.out.println("5");
					}else {
						System.out.println(" ");
					}
				}
			}
			System.out.println();
		}

	}

}
