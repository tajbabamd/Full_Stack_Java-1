class Employee{
	private String name, jobTitle;
	private double salary;
	
//	setter methods
	public void setName(String name) {
		this.name = name;
	}
	public void setJobTittle(String jobTitle) {
		this.jobTitle = jobTitle;
	}
	
//	getter methods
	public String getName() {
		return name;
	}
	public String getJobTitle() {
		return jobTitle;
	}
	public double getSalary() {
		return salary;
	}

//	calculation methods
	public void calculateSalary() {

		if(jobTitle == "Manager") {
			salary = 10000.00;
		}else if(jobTitle == "Sales Man") {
			salary = 5000.00; 
		}else if(jobTitle == "Accountant") {
			salary = 3000.00;
		}else {
			salary = 2000.00;
		}
	}
	
	//print method
	public void printDetails() {
		System.out.println("Employee Details");
		System.out.println("-".repeat(23));
		System.out.println("Name: " + getName() );
		System.out.println("Job Title: "+ getJobTitle()); 
		System.out.println("Salary: " + getSalary()); 
		System.out.println("-".repeat(23));
		System.out.println();
	}
}


public class Practice4 {

	public static void main(String[] args) {
		
		Employee e1 = new Employee();
		Employee e2 = new Employee();
		Employee e3 = new Employee();
		Employee e4 = new Employee();
		
//		setting name and job tittle
		e1.setName("John");
		e1.setJobTitle("Manager");
		
		e2.setName("Steve");
		e2.setJobTitle("Sales Man");
		
		e3.setName("Robert");
		e3.setJobTitle("Accountant");

		e4.setName("Fury");
		e4.setJobTitle("Attendent");
		
//		calculating salary for the given job tittle
		e1.calculateSalary();
		e2.calculateSalary();
		e3.calculateSalary();
		e4.calculateSalary();
		
//		printing the details of the employes
		e1.printDetails();
		e2.printDetails();
		e3.printDetails();
		e4.printDetails();
		
//		promoting and demoting  the  employees
		e2.setJobTitle("Accountant");
		e3.setJobTitle("Sales Man");
		
//		calculating the salary for the promoted and demoted employees
		e2.calculateSalary();
		e3.calculateSalary();
		
//		printing details of the employees
		e1.printDetails();
		e2.printDetails();
		e3.printDetails();
		e4.printDetails();
		
	}

}
