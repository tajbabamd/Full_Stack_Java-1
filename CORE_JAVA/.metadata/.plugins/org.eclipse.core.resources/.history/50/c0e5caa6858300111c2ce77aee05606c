package JavaEasyBook;

public class PracticePg57A {
	/*a program to print pattern 
	 * [A B C D E
	 *  A B C D E 
	 *  A B C D E
	 *  A B C D E ]*/
	public static void main(String[] args) {
		
		for(int i = 1; i <= 5; i++) {
			for(char j = 65; j <= 69; j++) {
				System.out.println(j + " ");
			}
			System.out.println();
		}

	}

}
